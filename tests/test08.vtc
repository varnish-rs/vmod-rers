varnishtest "replace_req_body on the backend side"

server s1 {
	rxreq
	txresp
	expect resp.body == "0ABBCCCDDDD6789"

	rxreq
	txresp
	expect resp.body == abcZYX
} -start

varnish v1 -arg "-p thread_pool_stack=160k" -vcl+backend {
	import rers from "${vmod}";

	sub vcl_init {
		new re_cache = rers.init(2);
	}

	sub vcl_recv {
		return (pass);
	}

	sub vcl_backend_fetch {
		re_cache.replace_req_body("1", "A");
		re_cache.replace_req_body("2", "BB");
		re_cache.replace_req_body("3", "CCC");
		re_cache.replace_req_body("CCC4.", "CCCDDDD");
		re_cache.replace_req_body("f", "X");
		re_cache.replace_req_body("e", "Y");
		re_cache.replace_req_body("d", "Z");
		set bereq.filters = "rers";
	}
} -start

client c1 {
	txreq -method POST -body "0123456789"
	rxresp

	txreq -method POST -body "abcdef"
	rxresp
} -run

server s1 -wait
